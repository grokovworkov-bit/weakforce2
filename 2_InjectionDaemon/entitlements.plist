<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  TweakForce — 2_InjectionDaemon/entitlements.plist
  ============================================================================
  Полный список entitlements для arm64e PAC injection на Dopamine (rootless):

  1. platform-application: true
     Помечает бинарник как системное платформенное приложение, снимая ряд ограничений ядра.

  2. com.apple.private.security.no-sandbox: true
     Полностью отключает песочницу (App Sandbox), открывая доступ к ФС и системным службам.

  3. com.apple.private.skip-library-validation: true
     Отключает Library Validation, позволяя загружать неподписанные или ad-hoc dylib в процесс.

  4. get-task-allow: true & task_for_pid-allow: true
     Критически необходимы для успешного выполнения task_for_pid(mach_task_self(), pid, &task).
     Без них ядро XNU возвращает KERN_FAILURE или KERN_PROTECTION_FAILURE.

  5. com.apple.security.exception.mach-register.global-name: [com.tweakforce.daemon]
     Разрешает регистрацию глобального имени Mach-порта в launchd для CFMessagePort IPC.

  6. dynamic-codesigning: true
     Разрешает динамическое исполнение кода (MAP_JIT и mach_vm_remap) без запрета CS_KILL.

  7. com.apple.private.security.container-required: false
     Запрещает принудительное создание изолированного контейнера данных.

  8. com.apple.private.iohideventsystem.connect.hard: false
     Опциональное отключение жестких связей с IOHID подсистемой.
  ============================================================================
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Платформенное приложение платформы Apple -->
    <key>platform-application</key>
    <true/>

    <!-- Отключение песочницы -->
    <key>com.apple.private.security.no-sandbox</key>
    <true/>

    <!-- Пропуск валидации сторонних библиотек -->
    <key>com.apple.private.skip-library-validation</key>
    <true/>

    <!-- Разрешение отладки и task_for_pid -->
    <key>get-task-allow</key>
    <true/>
    <key>task_for_pid-allow</key>
    <true/>

    <!-- Доступ к системным портам задач и отладчику -->
    <key>com.apple.system-task-ports</key>
    <true/>
    <key>com.apple.private.cs.debugger</key>
    <true/>

    <!-- Разрешение регистрации глобального имени Mach-порта в launchd -->
    <key>com.apple.security.exception.mach-register.global-name</key>
    <array>
        <string>com.tweakforce.daemon</string>
    </array>

    <!-- Динамическая кодовая подпись для MAP_JIT и mach_vm_remap -->
    <key>dynamic-codesigning</key>
    <true/>

    <!-- Работа без принудительного контейнера приложений -->
    <key>com.apple.private.security.container-required</key>
    <false/>
    <key>com.apple.private.security.no-container</key>
    <true/>

    <!-- Опциональное свойство подключения к IOHID Event System -->
    <key>com.apple.private.iohideventsystem.connect.hard</key>
    <false/>
</dict>
</plist>
