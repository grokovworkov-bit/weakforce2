#!/bin/sh
set -e

# Create log and config directories
mkdir -p /var/jb/etc /var/jb/var/mobile/Library/TweakForce /var/jb/var/mobile/Library/Logs/TweakForce 2>/dev/null || true
chown -R mobile:mobile /var/jb/var/mobile/Library/TweakForce /var/jb/var/mobile/Library/Logs/TweakForce 2>/dev/null || true

# Reload LaunchDaemon
LAUNCHCTL=""
if [ -x "/var/jb/bin/launchctl" ]; then
    LAUNCHCTL="/var/jb/bin/launchctl"
elif [ -x "/bin/launchctl" ]; then
    LAUNCHCTL="/bin/launchctl"
fi

PLIST="/var/jb/Library/LaunchDaemons/com.tweakforce.daemon.plist"
if [ -n "$LAUNCHCTL" ] && [ -f "$PLIST" ]; then
    $LAUNCHCTL bootout system "$PLIST" 2>/dev/null || true
    $LAUNCHCTL bootstrap system "$PLIST" 2>/dev/null || true
    $LAUNCHCTL kickstart -k system/com.tweakforce.daemon 2>/dev/null || true
fi

exit 0
